<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0D5B6E">
<title>Tableau de bord â€” CSM Manager</title>
<link rel="icon" type="image/webp" href="../200.webp">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../shared/styles.css">
<style>
:root{
  --teal:#0D5B6E;
  --teal-dark:#094A5A;
  --teal-light:#E8F0F2;
  --gray-bg:#F2F4F5;
  --gray-border:#CDD3D6;
  --gray-muted:#5A6A70;
  --red:#C0392B;
  --green:#4C9A5D;
  --amber:#D68F00;
  --gold:#C9A227;
  --blue-edit-border:#8FC0D9;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;}
body{
  font-family:'Space Grotesk',-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:15px;
  color:var(--text);
  background:var(--gray-bg);
  min-height:100vh;
  padding-bottom:calc(72px + env(safe-area-inset-bottom, 0px));
  overflow-x:hidden;
}
.topbar{
  background:var(--teal);
  color:#FFFFFF;
  padding:14px 16px;
  display:flex;align-items:center;gap:12px;
  position:sticky;top:0;z-index:20;
  padding-top:calc(14px + env(safe-area-inset-top, 0px));
}
.topbar h1{margin:0;font-size:17px;font-weight:600;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.topbar .bell{background:none;border:none;color:#FFFFFF;padding:8px;cursor:pointer;position:relative;display:flex;align-items:center;}
.topbar .bell svg{width:22px;height:22px;stroke:currentColor;stroke-width:2;fill:none;}
.topbar .bell .dot{position:absolute;top:6px;right:6px;width:10px;height:10px;background:var(--red);border-radius:50%;border:2px solid var(--teal);display:none;}
.topbar .bell .dot.show{display:block;}

.page-head{padding:20px 18px 12px;}
.page-head .title{font-size:22px;font-weight:600;color:var(--text);margin:0 0 2px;}
.page-head .date{font-size:13px;color:var(--gray-muted);font-family:'IBM Plex Mono',monospace;}

.alert-banner{margin:0 18px 14px;padding:12px 14px;font-size:13px;font-weight:600;display:none;align-items:center;gap:8px;line-height:1.4;}
.alert-banner.show{display:flex;}
.alert-banner.crit{background:#F7DAD5;color:#A32B1B;border:1px solid #C0392B;}
.alert-banner.warn{background:#FBF0D2;color:#8A5A00;border:1px solid #D68F00;}
.alert-banner .icon{width:16px;height:16px;flex:none;stroke-width:2.2;fill:none;stroke:currentColor;}

.filters{display:flex;gap:6px;padding:0 18px 14px;overflow-x:auto;scrollbar-width:none;}
.filters::-webkit-scrollbar{display:none;}
.chip{background:#FFFFFF;border:1px solid var(--gray-border);color:var(--gray-muted);padding:8px 14px;font-size:13px;font-family:inherit;font-weight:500;cursor:pointer;border-radius:18px;white-space:nowrap;transition:all .15s;min-height:36px;display:inline-flex;align-items:center;touch-action:manipulation;}
.chip:active{transform:scale(0.96);}
.chip.active{background:var(--teal);color:#FFFFFF;border-color:var(--teal);}

.cards-container{padding:0 18px;display:flex;flex-direction:column;gap:12px;}

.emp-card{background:#FFFFFF;border:1px solid var(--gray-border);border-left:4px solid var(--gray-border);padding:16px;display:flex;flex-direction:column;gap:12px;}
.emp-card.st-ok{border-left-color:var(--green);}
.emp-card.st-warn{border-left-color:var(--amber);background:#FFFCF5;}
.emp-card.st-crit{border-left-color:var(--red);background:#FFF8F6;}
.emp-card.st-break{border-left-color:var(--blue-edit-border);background:#F5F9FC;}
.emp-card.st-breakover{border-left-color:var(--red);background:#FFF8F6;}
.emp-card.st-done{opacity:0.7;}

.emp-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;}
.emp-id{flex:1;min-width:0;}
.emp-name{font-size:16px;font-weight:600;color:var(--text);line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.emp-badge{font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:var(--gray-muted);margin-top:2px;}

.status-pill{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;font-size:11.5px;font-weight:600;border-radius:2px;white-space:nowrap;flex-shrink:0;}
.status-pill.ok{background:#E0F1E4;color:#2F7D46;}
.status-pill.warn{background:#FBF0D2;color:#8A5A00;}
.status-pill.crit{background:#F7DAD5;color:#A32B1B;}
.status-pill.brk{background:#E6F0F7;color:#0D5B6E;}
.status-pill.done{background:#E8ECEE;color:var(--gray-muted);}
.status-pill .dot{width:6px;height:6px;background:currentColor;border-radius:50%;flex:none;}

.emp-times{grid-template-columns:1fr 1fr 1fr !important;}
@media (max-width:400px){.emp-times{grid-template-columns:1fr 1fr !important;}}
.emp-times{display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;padding:12px 0;border-top:1px solid #EDF2F4;border-bottom:1px solid #EDF2F4;}
.time-item{display:flex;flex-direction:column;gap:2px;}
.time-item .lbl{font-size:11px;color:var(--gray-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.03em;}
.time-item .val{font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:600;color:var(--text);}
.time-item .val.muted{color:var(--gray-muted);font-weight:400;}

.emp-actions{display:flex;gap:8px;flex-wrap:wrap;}
.act-btn{flex:1 1 0;min-width:120px;padding:12px 14px;font-size:14px;font-weight:600;font-family:inherit;border:1px solid var(--gray-border);background:#FFFFFF;color:var(--text);cursor:pointer;min-height:46px;display:flex;align-items:center;justify-content:center;gap:6px;touch-action:manipulation;transition:background .15s, transform .1s;}
.act-btn:active{transform:scale(0.97);}
.act-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2.2;fill:none;}
.act-btn.break{background:var(--amber);color:#FFFFFF;border-color:var(--amber);}
.act-btn.return{background:var(--green);color:#FFFFFF;border-color:var(--green);}
.act-btn.out{background:#FFFFFF;color:var(--red);border-color:var(--red);}
.emp-done{text-align:center;padding:12px;color:var(--gray-muted);font-size:13.5px;font-style:italic;}

.empty{padding:60px 24px;text-align:center;color:var(--gray-muted);background:#FFFFFF;border:1px dashed var(--gray-border);margin:0 18px;}
.empty .icon{width:52px;height:52px;margin:0 auto 14px;stroke:var(--gray-border);stroke-width:1.5;fill:none;}
.empty b{display:block;color:var(--text);font-size:15px;font-weight:600;margin-bottom:6px;}

.bottomnav{position:fixed;bottom:0;left:0;right:0;background:#FFFFFF;border-top:1px solid var(--gray-border);display:grid;grid-template-columns:repeat(5, 1fr);padding-bottom:env(safe-area-inset-bottom, 0px);z-index:30;box-shadow:0 -2px 8px rgba(0,0,0,0.04);}
.nav-item{background:none;border:none;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:8px 4px 10px;color:var(--gray-muted);font-family:inherit;font-size:10.5px;font-weight:600;cursor:pointer;touch-action:manipulation;min-height:64px;position:relative;}
.nav-item:active{background:var(--gray-bg);}
.nav-item.active{color:var(--teal);}
.nav-item svg{width:24px;height:24px;stroke:currentColor;stroke-width:2;fill:none;}
.nav-item.active svg{stroke-width:2.4;}
.nav-item .badge{position:absolute;top:6px;right:calc(50% - 18px);background:var(--red);color:#FFFFFF;font-size:9.5px;font-weight:700;min-width:16px;height:16px;padding:0 4px;border-radius:8px;display:flex;align-items:center;justify-content:center;border:2px solid #FFFFFF;}
.nav-item .badge.hidden{display:none;}

#loadingOverlay{position:fixed;inset:0;background:#0D5B6E;color:#fff;display:flex;align-items:center;justify-content:center;z-index:100;font-size:14px;letter-spacing:0.05em;}
#loadingOverlay.hidden{display:none;}

/* ---- forced light theme fix ---- */
html,body{color:#1A2A30 !important;background:#F2F4F5 !important;}
.emp-name{color:#1A2A30 !important;}
.emp-badge{color:#5A6A70 !important;}
.time-item .val{color:#1A2A30 !important;}
.time-item .val.muted{color:#5A6A70 !important;}
.time-item .lbl{color:#5A6A70 !important;}
.empty b{color:#1A2A30 !important;}
.empty{color:#5A6A70 !important;}
.page-head .title{color:#1A2A30 !important;}
.page-head .date{color:#5A6A70 !important;}
.time-item .val.strong{color:var(--teal);font-weight:700;}</style>
</head>
<body>

<div id="loadingOverlay">Chargementâ€¦</div>

<div class="topbar">
  <h1>CSM Manager</h1>
  <button class="bell" id="bellBtn" aria-label="Notifications">
    <svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
    <span class="dot" id="bellDot"></span>
  </button>
</div>

<div class="page-head">
  <h1 class="title">Tableau de bord</h1>
  <div class="date" id="todayDate">â€”</div>
</div>

<div class="alert-banner crit" id="critBanner">
  <svg class="icon" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
  <span id="critText"></span>
</div>

<div class="alert-banner warn" id="warnBanner">
  <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
  <span id="warnText"></span>
</div>

<div class="filters">
  <button class="chip active" data-filter="all">Tous</button>
  <button class="chip" data-filter="working">En poste</button>
  <button class="chip" data-filter="break">En pause</button>
  <button class="chip" data-filter="action">Action requise</button>
</div>

<div class="cards-container" id="cards"></div>

<div class="empty" id="emptyState" style="display:none;">
  <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
  <b>Aucun quart chargÃ©</b>
  Les employÃ©s qui pointent apparaÃ®tront ici automatiquement.
</div>

<div class="bottomnav">
  <button class="nav-item active" data-page="dashboard">
    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
    <span>Pointages</span>
  </button>
  <button class="nav-item" data-page="planning">
    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/></svg>
    <span>Planning</span>
  </button>
  <button class="nav-item" data-page="staff">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0116 0v1"/></svg>
    <span>EmployÃ©s</span>
  </button>
  <button class="nav-item" data-page="requests">
    <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/></svg>
    <span>Demandes</span>
    <span class="badge hidden" id="requestsBadge">0</span>
  </button>
  <button class="nav-item" data-page="daily-import">
    <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
    <span>Import</span>
  </button>
</div>

<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
<script src="../shared/firebase.js"></script>
<script src="../shared/rules-helpers.js"></script>
<script>
(function(){
  'use strict';

  const $ = function(id){ return document.getElementById(id); };
  const R = window.CSMRules;

  // ============================================================
  // State
  // ============================================================
  let shifts = [];
  let currentFilter = 'all';
  let unsubscribe = null;
  let started = false;

  // ============================================================
  // Auth gate â€” kick to login if not authenticated
  // ============================================================
  CSM.authReady.then(function(){
    auth.onAuthStateChanged(function(user){
      if(!user){
        window.location.replace('login.html');
        return;
      }
      if(started) return;
      started = true;
      db.collection('managerRestaurants').doc(user.uid).get().then(function(doc){
        if(!doc.exists){
          auth.signOut();
          return;
        }
        CSM.ready.then(startLive);
      }).catch(function(){
        CSM.ready.then(startLive);
      });
    });
  });

  function startLive(){
    $('loadingOverlay').classList.add('hidden');
    updateDate();
    const today = R.todayKey();
    unsubscribe = CSM.refs.shifts()
      .where('date', '==', today)
      .onSnapshot(function(snap){
        shifts = snap.docs.map(function(d){ return Object.assign({ id: d.id }, d.data()); });
        render();
      }, function(err){
        console.error('shifts listener:', err);
        render();
      });
  }

  // ============================================================
  // Render
  // ============================================================
  function render(){
    const container = $('cards');
    const empty = $('emptyState');
    container.innerHTML = '';

    if(shifts.length === 0){
      empty.style.display = 'block';
      updateAlerts([]);
      return;
    }
    empty.style.display = 'none';

    const processed = shifts.map(function(s){
      return { shift: s, calc: R.computeShift(s) };
    });

    const filtered = processed.filter(function(item){
      const { calc } = item;
      if(currentFilter === 'working') return calc.status === 'ok' || calc.status === 'warn';
      if(currentFilter === 'break') return calc.status === 'break' || calc.status === 'breakover';
      if(currentFilter === 'action') return calc.status === 'warn' || calc.status === 'crit' || calc.status === 'breakover';
      return true;
    });

    if(filtered.length === 0){
      container.innerHTML = '<div style="padding:40px 20px;text-align:center;color:var(--gray-muted);font-size:14px;">Aucun employÃ© dans ce filtre.</div>';
      updateAlerts(processed);
      return;
    }

    const rank = function(s){ return ({crit:0, breakover:0, warn:1, break:2, ok:3, done:4, nodata:5})[s] ?? 6; };
    filtered.sort(function(a, b){
      return rank(a.calc.status) - rank(b.calc.status) ||
             ((a.shift.clockIn ?? 999) - (b.shift.clockIn ?? 999));
    });

    updateAlerts(processed);

    filtered.forEach(function(item){
      container.appendChild(buildCard(item.shift, item.calc));
    });
  }

  function buildCard(shift, calc){
    const card = document.createElement('div');
    const statusClass = ({
      ok:'st-ok', warn:'st-warn', crit:'st-crit',
      break:'st-break', breakover:'st-breakover', done:'st-done', nodata:'st-done'
    })[calc.status] || '';
    card.className = 'emp-card ' + statusClass;

    const pillClass = ({
      ok:'ok', warn:'warn', crit:'crit', break:'brk',
      breakover:'crit', done:'done', nodata:'done'
    })[calc.status] || 'done';

    let timesHtml = '';
    timesHtml += timeRow('EntrÃ©e', R.minToHM(shift.clockIn));
    timesHtml += timeRow('Pause', R.minToHM(shift.breakStart));
    timesHtml += timeRow('Retour', R.minToHM(shift.breakReturn));
    timesHtml += timeRow('Sortie', R.minToHM(shift.clockOut));
    timesHtml += timeRow('Total', R.fmtHrs(calc.totalMinutes), true);

    const ICONS = {
      break: '<svg viewBox="0 0 24 24"><path d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/></svg>',
      ret:   '<svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 109-9 9.75 9.75 0 00-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>',
      end:   '<svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="1"/></svg>'
    };

    let actionsHtml = '';
    const sid = escapeAttr(shift.id);
    if(shift.clockOut !== null && shift.clockOut !== undefined){
      actionsHtml = '<div class="emp-done">JournÃ©e terminÃ©e</div>';
    } else if(shift.breakStart === null || shift.breakStart === undefined){
      actionsHtml =
        '<button class="act-btn break" data-act="break" data-id="'+sid+'">' + ICONS.break + 'DÃ©part pause</button>' +
        '<button class="act-btn out" data-act="out" data-id="'+sid+'">' + ICONS.end + 'Sortie</button>';
    } else if(shift.breakReturn === null || shift.breakReturn === undefined){
      actionsHtml =
        '<button class="act-btn return" data-act="return" data-id="'+sid+'">' + ICONS.ret + 'Retour pause</button>' +
        '<button class="act-btn out" data-act="out" data-id="'+sid+'">' + ICONS.end + 'Sortie</button>';
    } else {
      actionsHtml =
        '<button class="act-btn out" data-act="out" data-id="'+sid+'">' + ICONS.end + 'Sortie</button>';
    }

    card.innerHTML =
      '<div class="emp-top">' +
        '<div class="emp-id">' +
          '<div class="emp-name">' + escapeHtml(shift.name || 'EmployÃ©') + '</div>' +
          '<div class="emp-badge">Badge ' + escapeHtml(shift.badge) + '</div>' +
        '</div>' +
        '<span class="status-pill ' + pillClass + '">' +
          '<span class="dot"></span>' + escapeHtml(calc.statusLabel) +
        '</span>' +
      '</div>' +
      '<div class="emp-times">' + timesHtml + '</div>' +
      '<div class="emp-actions">' + actionsHtml + '</div>';

    card.querySelectorAll('.act-btn[data-act]').forEach(function(btn){
      btn.addEventListener('click', function(){
        handleAction(btn.dataset.act, btn.dataset.id);
      });
    });

    return card;
  }

  function timeRow(label, value){
    const muted = value ? '' : ' muted';
    return '<div class="time-item">' +
      '<span class="lbl">' + escapeHtml(label) + '</span>' +
      '<span class="val' + muted + '">' + (value || 'â€”') + '</span>' +
    '</div>';
  }

  function updateAlerts(processed){
    const crit = processed.filter(function(p){ return p.calc.status === 'crit' || p.calc.status === 'breakover'; });
    const warn = processed.filter(function(p){ return p.calc.status === 'warn'; });

    if(crit.length > 0){
      $('critText').textContent = crit.length + ' employÃ©(s) en alerte critique : ' +
        crit.map(function(p){ return p.shift.name; }).join(', ');
      $('critBanner').classList.add('show');
    } else {
      $('critBanner').classList.remove('show');
    }

    if(warn.length > 0){
      $('warnText').textContent = warn.length + ' employÃ©(s) proche(s) de la limite';
      $('warnBanner').classList.add('show');
    } else {
      $('warnBanner').classList.remove('show');
    }

    if(crit.length + warn.length > 0){
      $('bellDot').classList.add('show');
    } else {
      $('bellDot').classList.remove('show');
    }
  }

  // ============================================================
  // Actions â€” write to Firestore
  // ============================================================
  function handleAction(act, shiftId){
    const t = R.nowMinutes();
    const patch = {};
    if(act === 'break')  patch.breakStart = t;
    if(act === 'return') patch.breakReturn = t;
    if(act === 'out')    patch.clockOut = t;

    const shift = shifts.find(function(s){ return s.id === shiftId; });
    if(!shift){ return; }

    if(act === 'return' && shift.breakStart != null){
      let elapsed = t - shift.breakStart; if(elapsed < 0) elapsed += 1440;
      if(elapsed < R.BREAK_MIN){
        if(!confirm(
          'Pause non terminÃ©e\n\n' +
          (shift.name || 'Cet employÃ©') + " n'a pris que " + elapsed +
          " min sur les 30 min obligatoires.\n\nConfirmer le retour maintenant ?"
        )) return;
      }
    }

    if(act === 'out'){
      const merged = Object.assign({}, shift, patch);
      patch.totalMinutes = R.computeShift(merged).totalMinutes;
      patch.status = 'closed';
    }
    patch.updatedAt = new Date().toISOString();

    CSM.refs.shift(shiftId).update(patch).catch(function(err){
      alert('Erreur : ' + err.message);
    });
  }

  // ============================================================
  // Filters
  // ============================================================
  document.querySelectorAll('.chip').forEach(function(chip){
    chip.addEventListener('click', function(){
      document.querySelectorAll('.chip').forEach(function(c){ c.classList.remove('active'); });
      chip.classList.add('active');
      currentFilter = chip.dataset.filter;
      render();
    });
  });

  // ============================================================
  // Bottom nav
  // ============================================================
  document.querySelectorAll('.nav-item').forEach(function(item){
    item.addEventListener('click', function(){
      const page = item.dataset.page;
      if(page === 'dashboard') return;
      if(page === 'planning')  return window.location.href = 'planing.html';
      if(page === 'staff')     return window.location.href = 'staff.html';
      if(page === 'requests')  return window.location.href = 'requests.html';
      if(page === 'daily-import')      return window.location.href = 'daily-import.html';
    });
  });

  // ============================================================
  // Notification bell (visual only for now)
  // ============================================================
  $('bellBtn').addEventListener('click', function(){
    const crit = shifts.filter(function(s){
      const c = R.computeShift(s);
      return c.status === 'crit' || c.status === 'breakover' || c.status === 'warn';
    });
    if(crit.length === 0){
      alert('Aucune alerte en cours.');
    } else {
      alert(crit.length + ' alerte(s) :\n\n' + crit.map(function(s){
        return 'â€¢ ' + (s.name || s.badge) + ' â€” ' + R.computeShift(s).statusLabel;
      }).join('\n'));
    }
  });

  // ============================================================
  // Date display
  // ============================================================
  function updateDate(){
    const days = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
    const months = ['janvier','fÃ©vrier','mars','avril','mai','juin','juillet','aoÃ»t','septembre','octobre','novembre','dÃ©cembre'];
    const d = new Date();
    $('todayDate').textContent = days[d.getDay()] + ' ' + d.getDate() + ' ' + months[d.getMonth()] + ' ' + d.getFullYear();
  }

  function escapeHtml(s){
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function escapeAttr(s){ return escapeHtml(s); }

  setInterval(function(){ if(started) render(); }, 15000);

})();
</script>
</body>
</html>